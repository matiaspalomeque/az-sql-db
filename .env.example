DB_SERVER=DB_NAME_TEST.database.windows.net
DB_USER=user
DB_PASSWORD=password
DB_PORT=1433
DB_ENCRYPT=true
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=300000

# DTU throttling delays (milliseconds)
INDEX_REBUILD_DELAY_MS=2000      # After REBUILD operations
INDEX_REORGANIZE_DELAY_MS=500    # After REORGANIZE operations

# Retry configuration with exponential backoff
RETRY_MAX_ATTEMPTS=3             # Maximum retry attempts
RETRY_BASE_DELAY_MS=1000         # Base delay (exponential: 1s, 2s, 4s, 8s...)
RETRY_MAX_DELAY_MS=30000         # Maximum delay cap

# Index rebuild mode (true = ONLINE, false = OFFLINE)
# Can be overridden with --online or --offline CLI flags
INDEX_REBUILD_ONLINE=true

# Clear procedure cache after maintenance (per-database)
# Forces recompilation of execution plans to use fresh statistics
# Only runs on databases where at least one index was rebuilt/reorganized
FREE_PROC_CACHE=false
